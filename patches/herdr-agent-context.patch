+fn refresh_terminal_git_contexts(
+    items: Vec<(crate::terminal::TerminalId, PathBuf)>,
+) -> Vec<(
+    crate::terminal::TerminalId,
+    crate::terminal::state::TerminalGitContext,
+)> {
