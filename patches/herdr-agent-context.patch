+        .map(|(id, cwd)| {
+            let context = by_cwd
+                .entry(cwd.clone())
+                .or_insert_with(|| {
+                    let space = crate::workspace::git_space_metadata(&cwd);
+                    let branch = space
+                        .as_ref()
+                        .and_then(|space| crate::workspace::git_branch(&space.repo_root));
+                    crate::terminal::state::TerminalGitContext {
+                        cwd,
+                        repo: space.map(|space| space.repo_name),
+                        branch,
+                    }
+                })
+                .clone();
+            (id, context)
+        })
+        .collect()
