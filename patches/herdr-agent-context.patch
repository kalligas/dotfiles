+/// Git identity sampled for this terminal, independently of its workspace.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TerminalGitContext {
+    pub cwd: PathBuf,
+    pub repo: Option<String>,
+    pub branch: Option<String>,
+}
+
 impl TerminalState {
+    pub(crate) fn git_context_cwd(
+        &self,
+        runtime: Option<&crate::terminal::TerminalRuntime>,
+    ) -> PathBuf {
+        runtime
+            .and_then(|runtime| runtime.foreground_cwd().or_else(|| runtime.cwd()))
+            .unwrap_or_else(|| self.cwd.clone())
+    }
+
+    pub(crate) fn sidebar_tokens(
+        &self,
+        runtime: Option<&crate::terminal::TerminalRuntime>,
+    ) -> HashMap<String, String> {
+        let mut tokens = self.metadata_tokens.values();
+        // These two tokens are reserved for the sampled terminal Git identity.
+        tokens.remove("repo");
+        tokens.remove("branch");
+        if let Some(context) = self
+            .git_context
+            .as_ref()
+            .filter(|context| context.cwd == self.git_context_cwd(runtime))
+        {
+            if let Some(repo) = &context.repo {
+                tokens.insert("repo".into(), repo.clone());
+            }
+            if let Some(branch) = &context.branch {
+                tokens.insert("branch".into(), branch.clone());
+            }
+        }
+        tokens
+    }
