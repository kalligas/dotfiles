+    #[test]
+    fn dotfiles_expanded_agent_cards_round_only_the_focused_agent_and_keep_token_colors() {
+        for row_count in [1, 4] {
+            for width in [3, 12, 30] {
+                let (mut app, first, second) = collapsed_agent_app();
+                app.active = Some(0);
+                app.palette.sidebar_bg = Color::Reset;
+                let config: crate::config::Config = toml::from_str(
+                    r##"
+[ui.sidebar.agents]
+rows = [[{ token = "workspace", fg = "#8eb7e3", bold = true, dim = false }]]
+row_gap = 1
+"##,
+                )
+                .unwrap();
+                app.sidebar_agents = config.ui.sidebar.agents;
+                app.sidebar_agents.rows = vec![app.sidebar_agents.rows[0].clone(); row_count];
+                let area = Rect::new(0, 0, width, 30);
+                for focused in [first, second] {
+                    app.workspaces[0].tabs[0].layout.focus_pane(focused);
+                    let details = agent_panel_entries_from(&app, &TerminalRuntimeRegistry::new());
+                    let metrics = agent_panel_scroll_metrics(&app, area);
+                    let body = agent_panel_body_rect(area, should_show_scrollbar(metrics));
+                    let mut terminal = Terminal::new(TestBackend::new(width, 30)).unwrap();
+                    let rendered = terminal
+                        .draw(|frame| {
+                            render_agent_detail(&app, &TerminalRuntimeRegistry::new(), frame, area)
+                        })
+                        .unwrap();
+                    let buffer = rendered.buffer;
+                    let mut y = body.y;
+                    for (index, detail) in details.iter().enumerate() {
+                        let height = row_count as u16;
+                        if y + height > body.bottom() {
+                            break;
+                        }
+                        let active =
+                            app.is_active_pane(detail.ws_idx, detail.tab_idx, detail.pane_id);
+                        if active {
+                            let (left_top, right_top, left_bottom, right_bottom) = if height == 1 {
+                                ("\u{10f000}", "\u{10f001}", "\u{10f000}", "\u{10f001}")
+                            } else {
+                                ("\u{1fbee}", "\u{1fbed}", "\u{1fbec}", "\u{1fbef}")
+                            };
+                            for (x, row, symbol) in [
+                                (body.x, y, left_top),
+                                (body.right() - 1, y, right_top),
+                                (body.x, y + height - 1, left_bottom),
+                                (body.right() - 1, y + height - 1, right_bottom),
+                            ] {
+                                let cell = &buffer[(x, row)];
+                                assert_eq!(cell.symbol(), symbol);
+                                assert_eq!(cell.fg, FOCUSED_PANE_BACKGROUND);
+                                assert_eq!(cell.bg, Color::Reset);
+                            }
+                            if width >= 12 {
+                                let cell = &buffer[(body.x + 1, y)];
+                                assert_eq!(cell.fg, Color::Rgb(142, 183, 227));
+                                assert_eq!(cell.bg, FOCUSED_PANE_BACKGROUND);
+                                assert!(cell.modifier.contains(Modifier::BOLD));
+                            }
+                        } else {
+                            assert_eq!(buffer[(body.x, y)].bg, Color::Reset);
+                            assert_eq!(buffer[(body.x, y)].symbol(), " ");
+                        }
+                        y += height + agent_entry_gap(&app, index, details.len());
+                    }
+                }
+            }
+        }
