+// Text reserves the outer columns so the same font corners used by panes
+// can round sidebar selections without covering labels or controls.
+fn render_card_corners(frame: &mut Frame, surface: Rect, background: Color, backdrop: Color) {
+    if surface.width < 3 || surface.height == 0 || background == Color::Reset {
+        return;
+    }
+    let corners = if surface.height == 1 {
+        vec![
+            (surface.x, surface.y, "\u{10f000}"),
+            (surface.right() - 1, surface.y, "\u{10f001}"),
+        ]
+    } else {
+        vec![
+            (surface.x, surface.y, "\u{1fbee}"),
+            (surface.right() - 1, surface.y, "\u{1fbed}"),
+            (surface.x, surface.bottom() - 1, "\u{1fbec}"),
+            (surface.right() - 1, surface.bottom() - 1, "\u{1fbef}"),
+        ]
+    };
+    let visible = surface.intersection(frame.area());
+    for (x, y, symbol) in corners {
+        if x >= visible.x && x < visible.right() && y >= visible.y && y < visible.bottom() {
+            let cell = &mut frame.buffer_mut()[(x, y)];
+            cell.reset();
+            cell.set_symbol(symbol).set_fg(background).set_bg(backdrop);
+        }
+    }
+}
