+    #[test]
+    fn dotfiles_active_tab_padding_is_symmetric_without_moving_click_targets() {
+        for label in ["1", "22", "review", "提交", "a Z"] {
+            let mut app = AppState::test_new();
+            let mut ws = Workspace::test_new("test");
+            ws.tabs[0].set_custom_name(label.into());
+            app.workspaces = vec![ws];
+            app.active = Some(0);
+            app.view.tab_bar_rect = Rect::new(0, 0, 40, 1);
+            app.view.tab_hit_areas =
+                compute_tab_bar_view(&app.workspaces[0], app.view.tab_bar_rect, 0, true, false)
+                    .tab_hit_areas;
+            let hits = app.view.tab_hit_areas.clone();
+            let mut terminal = Terminal::new(TestBackend::new(40, 1)).unwrap();
+            let rendered = terminal
+                .draw(|frame| render_tab_bar(&app, frame, app.view.tab_bar_rect))
+                .unwrap();
+            let buffer = rendered.buffer;
+            let rect = hits[0];
+            let end = (rect.x..rect.right())
+                .find(|x| buffer[(*x, 0)].symbol() == ACTIVE_TAB_RIGHT_CAP)
+                .unwrap();
+            let mut left = 0;
+            while buffer[(rect.x + 1 + left, 0)].symbol() == " " {
+                left += 1;
+            }
+            // A wide glyph's trailing cell is blank in the frame. Count the
+            // label's display columns rather than mistaking that cell for padding.
+            let right = end - (rect.x + 1 + left + display_width_u16(label));
+            assert_eq!(left, right, "padding for {label}");
+            for x in end + 1..rect.right() {
+                assert_eq!(buffer[(x, 0)].bg, app.palette.panel_bg);
+            }
+            assert_eq!(app.view.tab_hit_areas, hits);
         }
     }
 
