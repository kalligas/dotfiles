-    info.is_focused.then_some(FOCUSED_PANE_BACKGROUND)
+    Some(if info.is_focused {
+        FOCUSED_PANE_BACKGROUND
+    } else {
+        INACTIVE_PANE_BACKGROUND
+    })
+}
+
+// The corner font bakes each surface color into its glyphs, so the unfocused
+// surface has its own four corners in the plane-16 private-use area.
+fn pane_corner_symbols(background: Color) -> [&'static str; 4] {
+    if background == INACTIVE_PANE_BACKGROUND {
+        ["\u{10f004}", "\u{10f005}", "\u{10f006}", "\u{10f007}"]
+    } else {
+        ["\u{1fbee}", "\u{1fbed}", "\u{1fbec}", "\u{1fbef}"]
+    }
 }
 
