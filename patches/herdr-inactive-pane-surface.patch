+// Unfocused panes sit on the lighter surface that inactive tabs use, so they
+// stand apart from the window background while the focused pane stays darkest.
+pub(super) const INACTIVE_PANE_BACKGROUND: Color = Color::Indexed(236);
+
 // Keep full redraws and retained terminal updates on the same focus rule.
