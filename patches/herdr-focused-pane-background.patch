+    #[tokio::test]
+    async fn focused_pane_background_rounds_padding_without_resizing_on_focus() {
+        use ratatui::{backend::TestBackend, Terminal};
+
+        let mut app = AppState::test_new();
+        app.mode = Mode::Terminal;
+        app.pane_borders = false;
+        app.pane_gaps = false;
+        app.pane_scrollbars = false;
+        let mut workspace = Workspace::test_new("test");
+        let left = workspace.tabs[0].root_pane;
+        let right = workspace.test_split(ratatui::layout::Direction::Horizontal);
+        for id in [left, right] {
+            workspace.tabs[0].runtimes.insert(
+                id,
+                TerminalRuntime::test_with_screen_bytes(
+                    12,
+                    6,
+                    b"\x1b[48;2;20;40;60mX\x1b[0m plain",
+                ),
+            );
+        }
+        app.workspaces = vec![workspace];
+        app.active = Some(0);
+        app.ensure_test_terminals();
+        let runtimes = TerminalRuntimeRegistry::new();
+        let mut terminal = Terminal::new(TestBackend::new(32, 8)).unwrap();
+        for focused in [left, right] {
+            app.workspaces[0].tabs[0].layout.focus_pane(focused);
+            let infos = compute_pane_infos(
+                &app,
+                &runtimes,
+                Rect::new(0, 0, 32, 8),
+                true,
+                crate::kitty_graphics::HostCellSize::default(),
+            );
+            terminal
+                .draw(|frame| render_panes(&app, &runtimes, frame, &infos, &[]))
+                .unwrap();
+            let buffer = terminal.backend().buffer();
+            for info in &infos {
+                let x = info.rect.x;
+                assert_eq!(info.inner_rect, Rect::new(x + 2, 1, 12, 6));
+                assert_eq!(
+                    app.workspaces[0].tabs[0].runtimes[&info.id].current_size(),
+                    (6, 12)
+                );
+                assert_eq!(buffer[(x + 2, 1)].symbol(), "X");
+                assert_eq!(buffer[(x + 2, 1)].bg, Color::Rgb(20, 40, 60));
+                assert_eq!(buffer[(x, 0)].bg, Color::Reset);
+                if info.id == focused {
+                    for (cx, cy, symbol) in [
+                        (x, 0, "\u{1fbee}"),
+                        (x + 15, 0, "\u{1fbed}"),
+                        (x, 7, "\u{1fbec}"),
+                        (x + 15, 7, "\u{1fbef}"),
+                    ] {
+                        assert_eq!(buffer[(cx, cy)].symbol(), symbol);
+                        assert_eq!(buffer[(cx, cy)].bg, Color::Reset);
+                        assert_eq!(buffer[(cx, cy)].fg, Color::Rgb(36, 39, 43));
+                    }
+                    assert_eq!(buffer[(x + 1, 0)].bg, Color::Rgb(36, 39, 43));
+                } else {
+                    assert_eq!(buffer[(x, 0)].symbol(), " ");
+                    assert_eq!(buffer[(x + 1, 0)].bg, Color::Reset);
+                }
+            }
+            // Background tabs and visible tabs must give PTYs identical geometry.
+            resize_tab_panes(
+                &app,
+                &runtimes,
+                &app.workspaces[0].tabs[0],
+                Rect::new(0, 0, 32, 8),
+                crate::kitty_graphics::HostCellSize::default(),
+            );
+            for id in [left, right] {
+                assert_eq!(
+                    app.workspaces[0].tabs[0].runtimes[&id].current_size(),
+                    (6, 12)
+                );
+            }
+        }
+        for (width, height) in [(1, 1), (7, 8), (12, 3)] {
+            let area = Rect::new(0, 0, width, height);
+            assert_eq!(pane_inner_rect(area, Borders::NONE, false), area);
+        }
+    }
