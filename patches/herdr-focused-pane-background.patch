+// Keep full redraws and retained terminal updates on the same focus rule.
+pub(crate) fn focused_pane_background(app: &AppState, info: &PaneInfo) -> Option<Color> {
+    let workspace = app.active.and_then(|index| app.workspaces.get(index))?;
+    (info.is_focused && workspace.layout.pane_count() > 1).then_some(Color::Rgb(36, 39, 43))
+}
+
+// Padding belongs to the pane, so moving focus never resizes a terminal.
+fn render_focused_pane_background(
+    app: &AppState,
+    frame: &mut Frame,
+    info: &PaneInfo,
+    background: Color,
+) {
+    let padded = !app.pane_borders && info.rect.width >= 8 && info.rect.height >= 4;
+    let surface = if padded { info.rect } else { info.inner_rect };
+    let area = surface.intersection(frame.area());
+    let buf = frame.buffer_mut();
+    for y in area.y..area.bottom() {
+        for x in area.x..area.right() {
+            // Applications keep explicit colors, including full-screen backgrounds.
+            let cell = &mut buf[(x, y)];
+            if cell.bg == Color::Reset {
+                cell.set_bg(background);
+            }
+        }
+    }
+    if padded {
+        // Filled quarter circles occupy padding, never application content.
+        // The small Herdr Pane Corners font supplies these Unicode 16 glyphs.
+        for (x, y, symbol) in [
+            (surface.x, surface.y, "\u{1fbee}"),
+            (surface.right() - 1, surface.y, "\u{1fbed}"),
+            (surface.x, surface.bottom() - 1, "\u{1fbec}"),
+            (surface.right() - 1, surface.bottom() - 1, "\u{1fbef}"),
+        ] {
+            if x >= area.x && x < area.right() && y >= area.y && y < area.bottom() {
+                buf[(x, y)]
+                    .set_symbol(symbol)
+                    .set_fg(background)
+                    .set_bg(Color::Reset);
+            }
+        }
+    }
+}
