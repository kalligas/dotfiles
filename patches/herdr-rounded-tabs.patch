+    #[test]
+    fn dotfiles_active_tabs_clip_wide_labels_inside_caps() {
+        for width in 1..=6 {
+            let mut app = AppState::test_new();
+            let mut ws = Workspace::test_new("test");
+            ws.tabs[0].set_custom_name("提交反馈".into());
+            app.workspaces = vec![ws];
+            app.active = Some(0);
+            app.view.tab_bar_rect = Rect::new(0, 0, 10, 1);
+            let rect = Rect::new(2, 0, width, 1);
+            app.view.tab_hit_areas = vec![rect];
+            let mut terminal = Terminal::new(TestBackend::new(10, 1)).unwrap();
+            let rendered = terminal
+                .draw(|frame| render_tab_bar(&app, frame, app.view.tab_bar_rect))
+                .unwrap();
+            // Inspect the frame: backend diffs skip a wide glyph's trailing cell.
+            let buffer = rendered.buffer;
+            if width >= 3 {
+                assert_eq!(buffer[(rect.x, 0)].symbol(), ACTIVE_TAB_LEFT_CAP);
+                assert_eq!(buffer[(rect.right() - 1, 0)].symbol(), ACTIVE_TAB_RIGHT_CAP);
+            } else {
+                for x in rect.x..rect.right() {
+                    assert_eq!(buffer[(x, 0)].bg, FOCUSED_PANE_BACKGROUND);
+                }
+            }
+            assert_eq!(buffer[(rect.right(), 0)].bg, app.palette.panel_bg);
+        }
+    }
