+    #[test]
+    fn dotfiles_active_tabs_round_both_ends_and_follow_selection() {
+        use ratatui::style::Color;
+        for panel_bg in [Color::Reset, Color::Rgb(10, 20, 30)] {
+            for selected in 0..2 {
+                let mut app = AppState::test_new();
+                let mut ws = Workspace::test_new("test");
+                ws.test_add_tab(Some("review"));
+                ws.active_tab = selected;
+                app.workspaces = vec![ws];
+                app.active = Some(0);
+                app.palette = crate::app::state::Palette::terminal();
+                app.palette.panel_bg = panel_bg;
+                app.view.tab_bar_rect = Rect::new(0, 0, 40, 1);
+                let view =
+                    compute_tab_bar_view(&app.workspaces[0], app.view.tab_bar_rect, 0, true, false);
+                app.view.tab_hit_areas = view.tab_hit_areas;
+                let hit_areas = app.view.tab_hit_areas.clone();
+                let mut terminal = Terminal::new(TestBackend::new(40, 1)).unwrap();
+                terminal
+                    .draw(|frame| render_tab_bar(&app, frame, app.view.tab_bar_rect))
+                    .unwrap();
+                assert_eq!(app.view.tab_hit_areas, hit_areas);
+                let buffer = terminal.backend().buffer();
+                for (idx, label) in [(0, "1"), (1, "review")] {
+                    let rect = hit_areas[idx];
+                    assert_eq!(rect.width, tab_width(&app.workspaces[0], idx));
+                    assert!(buffer_row_text(buffer, rect, 0).contains(label));
+                    if idx == selected {
+                        for (x, symbol) in [
+                            (rect.x, ACTIVE_TAB_LEFT_CAP),
+                            (rect.right() - 1, ACTIVE_TAB_RIGHT_CAP),
+                        ] {
+                            let cell = &buffer[(x, 0)];
+                            assert_eq!(cell.symbol(), symbol);
+                            assert_eq!(display_width_u16(symbol), 1);
+                            assert_eq!(cell.fg, FOCUSED_PANE_BACKGROUND);
+                            assert_eq!(cell.bg, panel_bg);
+                            assert!(!cell.modifier.contains(Modifier::BOLD));
+                        }
+                        for x in rect.x + 1..rect.right() - 1 {
+                            let cell = &buffer[(x, 0)];
+                            assert_eq!(cell.bg, FOCUSED_PANE_BACKGROUND);
+                            assert_eq!(cell.fg, app.palette.overlay1);
+                            assert!(cell.modifier.contains(Modifier::BOLD));
+                        }
+                    } else {
+                        for x in rect.x..rect.right() {
+                            let cell = &buffer[(x, 0)];
+                            assert_eq!(cell.bg, app.palette.surface0);
+                            assert_eq!(cell.fg, app.palette.overlay1);
+                            assert!(!cell.modifier.contains(Modifier::DIM));
+                            assert_ne!(cell.symbol(), ACTIVE_TAB_LEFT_CAP);
+                            assert_ne!(cell.symbol(), ACTIVE_TAB_RIGHT_CAP);
+                        }
+                    }
+                }
+            }
+        }
+    }
