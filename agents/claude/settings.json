{
  "autoMode": {
    "environment": [
      "$defaults"
    ],
    "allow": ["$defaults",
      "Running read-only commnads on production envs is always allowed",
      "Running read-only aws or databricks commands is always allowed"
    ]
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/projects/**)",
      "Read(~/.codex/sessions/**)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh search:*)",
      "Bash(gh api notifications:*)",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "mcp__clickup__clickup_create_comment",
      "mcp__clickup__clickup_update_task"
    ],
    "additionalDirectories": [
      "~/.claude/projects",
      "~/.codex/sessions"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/wikifarmer/dotfiles/agents/claude/statusline.sh"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "auto",
  "outputStyle": "Explanatory",
  "advisorModel": "fable"
}
