#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: tokcost [-p] [-u] [-c] [-e] [-from YYYY-MM-DD] [-to YYYY-MM-DD]

Show Tokscale cost by model.

Options:
  -p                  Group by project and model.
  -u, --usage         Add 5h and weekly usage columns. Claude rows show Claude
                      limits, Codex rows show Codex limits, other rows show n/a.
  -c [SECONDS]        Continuously refresh until Ctrl-C. Defaults to 5 seconds.
  -e                  Output CSV to stdout.
  -from YYYY-MM-DD    Start date. Defaults to today.
  -to YYYY-MM-DD      End date. Defaults to today.
  -h, --help          Show this help.
EOF
}

csv=0
continuous=0
interval=5
include_usage=0
project_view=0
from="$(date '+%F')"
to="$(date '+%F')"
continuous_rows_started=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -e)
      csv=1
      shift
      ;;
    -u|--usage)
      include_usage=1
      shift
      ;;
    -c|--continuous)
      continuous=1
      if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
        interval="$2"
        shift 2
      else
        shift
      fi
      ;;
    -p|--project|--projects)
      project_view=1
      shift
      ;;
    -from|--from|--since)
      [[ $# -ge 2 ]] || { echo "$1 requires YYYY-MM-DD." >&2; exit 1; }
      from="$2"
      shift 2
      ;;
    -to|--to|--until)
      [[ $# -ge 2 ]] || { echo "$1 requires YYYY-MM-DD." >&2; exit 1; }
      to="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

date_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
[[ "$from" =~ $date_re ]] || { echo "-from must use YYYY-MM-DD." >&2; exit 1; }
[[ "$to" =~ $date_re ]] || { echo "-to must use YYYY-MM-DD." >&2; exit 1; }
[[ "$interval" -gt 0 ]] || { echo "-c interval must be greater than zero." >&2; exit 1; }
[[ ! ( "$csv" -eq 1 && "$continuous" -eq 1 ) ]] || { echo "-e cannot be combined with -c." >&2; exit 1; }

for tool in npx jq awk; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "Missing required tool: $tool" >&2
    exit 1
  }
done

group_by="model"
[[ "$project_view" -eq 1 ]] && group_by="workspace,model"

rows_filter='
  .entries
  | sort_by(.cost // 0)
  | reverse
  | .[]
  | {
      project: (.workspaceLabel // .workspaceKey // "unknown"),
      model: (.model // "unknown"),
      cost: (.cost // 0),
      messages: (.messageCount // 0),
      tokens: ((.input // 0) + (.output // 0) + (.cacheRead // 0) + (.cacheWrite // 0) + (.reasoning // 0)),
      client: (.mergedClients // .client // ""),
      provider: (.provider // ""),
      usage_key: (
        ((.mergedClients // .client // "") | tostring | ascii_downcase) as $c
        | if ($c | contains("claude")) then "claude"
          elif ($c | contains("codex")) then "codex"
          else ""
          end
      )
    }
'

# Appended after rows_filter when -u is set. Each row picks up the limits of
# its own client from the $usage object that fetch_usage builds.
usage_join='
  | . + ($usage[.usage_key] // {fiveh: "n/a", weekly: "n/a", fiveh_reset: "", weekly_reset: ""})
'

fetch_costs() {
  npx tokscale@latest models \
    --group-by "$group_by" \
    --since "$from" \
    --until "$to" \
    --json \
    --no-spinner
}

fetch_usage() {
  if [[ "$include_usage" -ne 1 ]]; then
    echo '{}'
    return
  fi

  # Tokscale labels the Claude 5-hour window "Session" and the Codex one "5h".
  npx tokscale@latest usage --json |
    jq -c '
      def metric($provider; $name):
        [.[]
          | select((.provider // "" | ascii_downcase) == $provider)
          | .metrics[]
          | select((.label // "" | ascii_downcase) == $name)][0];
      def pct($m):
        if $m == null or $m.remaining_percent == null
        then "n/a"
        else (($m.remaining_percent | tostring) + "%")
        end;
      def reset($m):
        if $m == null or $m.resets_at == null
        then ""
        else $m.resets_at
        end;
      def limits($provider; $five_label):
        metric($provider; $five_label) as $five
        | metric($provider; "weekly") as $weekly
        | {fiveh: pct($five), weekly: pct($weekly), fiveh_reset: reset($five), weekly_reset: reset($weekly)};
      {claude: limits("claude"; "session"), codex: limits("codex"; "5h")}
    '
}

print_stream_header() {
  if [[ "$project_view" -eq 1 ]]; then
    if [[ "$include_usage" -eq 1 ]]; then
      printf "%-26s  %-22s  %10s  %8s  %12s  %10s  %12s\n" "PROJECT" "MODEL" "COST" "MSGS" "TOKENS" "5H USAGE" "WEEKLY USAGE"
    else
      printf "%-32s  %-24s  %10s  %8s  %12s\n" "PROJECT" "MODEL" "COST" "MSGS" "TOKENS"
    fi
  else
    if [[ "$include_usage" -eq 1 ]]; then
      printf "%-24s  %10s  %8s  %12s  %-10s  %-10s  %10s  %12s\n" "MODEL" "COST" "MSGS" "TOKENS" "CLIENT" "PROVIDER" "5H USAGE" "WEEKLY USAGE"
    else
      printf "%-28s  %10s  %8s  %12s  %-12s  %-12s\n" "MODEL" "COST" "MSGS" "TOKENS" "CLIENT" "PROVIDER"
    fi
  fi
}

render_once() {
  local json usage_json total_raw total count show_header
  local claude_fiveh claude_weekly codex_fiveh codex_weekly

  json="$(fetch_costs)"
  usage_json="$(fetch_usage)"
  IFS=$'\t' read -r claude_fiveh claude_weekly codex_fiveh codex_weekly <<<"$(
    jq -r '[.claude.fiveh, .claude.weekly, .codex.fiveh, .codex.weekly] | map(. // "n/a") | @tsv' <<<"$usage_json"
  )"

  total_raw="$(jq -r '.totalCost // 0' <<<"$json")"
  total="$(printf '$%.2f' "$total_raw")"
  count="$(jq -r '.entries | length' <<<"$json")"

  if [[ "$csv" -eq 1 ]]; then
    if [[ "$project_view" -eq 1 ]]; then
      if [[ "$include_usage" -eq 1 ]]; then
        jq -r --arg from "$from" --arg to "$to" --argjson usage "$usage_json" '
          ["from","to","project","model","cost_usd","messages","tokens","client","provider","5h_usage","weekly_usage","5h_resets_at","weekly_resets_at"],
          ('"$rows_filter$usage_join"' | [$from, $to, .project, .model, (.cost | tostring), .messages, .tokens, .client, .provider, .fiveh, .weekly, .fiveh_reset, .weekly_reset])
          | @csv
        ' <<<"$json"
      else
        jq -r --arg from "$from" --arg to "$to" '
          ["from","to","project","model","cost_usd","messages","tokens","client","provider"],
          ('"$rows_filter"' | [$from, $to, .project, .model, (.cost | tostring), .messages, .tokens, .client, .provider])
          | @csv
        ' <<<"$json"
      fi
    else
      if [[ "$include_usage" -eq 1 ]]; then
        jq -r --arg from "$from" --arg to "$to" --argjson usage "$usage_json" '
          ["from","to","model","cost_usd","messages","tokens","client","provider","5h_usage","weekly_usage","5h_resets_at","weekly_resets_at"],
          ('"$rows_filter$usage_join"' | [$from, $to, .model, (.cost | tostring), .messages, .tokens, .client, .provider, .fiveh, .weekly, .fiveh_reset, .weekly_reset])
          | @csv
        ' <<<"$json"
      else
        jq -r --arg from "$from" --arg to "$to" '
          ["from","to","model","cost_usd","messages","tokens","client","provider"],
          ('"$rows_filter"' | [$from, $to, .model, (.cost | tostring), .messages, .tokens, .client, .provider])
          | @csv
        ' <<<"$json"
      fi
    fi
    return
  fi

  if [[ "$continuous" -eq 1 ]]; then
    show_header=0
    if [[ "$continuous_rows_started" -eq 0 ]]; then
      print_stream_header
      continuous_rows_started=1
    fi
    printf -- '--- %s  range=%s..%s  total=%s  rows=%s' "$(date '+%Y-%m-%d %H:%M:%S')" "$from" "$to" "$total" "$count"
    if [[ "$include_usage" -eq 1 ]]; then
      printf '  claude 5h=%s weekly=%s  codex 5h=%s weekly=%s' "$claude_fiveh" "$claude_weekly" "$codex_fiveh" "$codex_weekly"
    fi
    printf ' ---\n'
  else
    show_header=1
    if [[ "$project_view" -eq 1 ]]; then
      printf 'Tokscale cost by project and model\n'
    else
      printf 'Tokscale cost by model\n'
    fi
    printf 'Range: %s to %s    Total: %s    Rows: %s\n' "$from" "$to" "$total" "$count"
    if [[ "$include_usage" -eq 1 ]]; then
      printf 'Claude usage: 5h %s remaining, weekly %s remaining\n' "$claude_fiveh" "$claude_weekly"
      printf 'Codex usage:  5h %s remaining, weekly %s remaining\n' "$codex_fiveh" "$codex_weekly"
    fi
    printf '\n'
  fi

  if [[ "$project_view" -eq 1 ]]; then
    if [[ "$include_usage" -eq 1 ]]; then
      jq -r --argjson usage "$usage_json" "$rows_filter$usage_join | [.project, .model, (.cost | tostring), (.messages | tostring), (.tokens | tostring), .fiveh, .weekly] | @tsv" <<<"$json" |
        awk -F '\t' -v show_header="$show_header" '
          function trim(s, n) {
            return length(s) > n ? substr(s, 1, n - 1) "..." : s
          }
          BEGIN {
            if (show_header == 1) {
              printf "%-26s  %-22s  %10s  %8s  %12s  %10s  %12s\n", "PROJECT", "MODEL", "COST", "MSGS", "TOKENS", "5H USAGE", "WEEKLY USAGE"
              printf "%-26s  %-22s  %10s  %8s  %12s  %10s  %12s\n", "-------", "-----", "----", "----", "------", "--------", "------------"
            }
          }
          {
            cost = sprintf("$%.2f", $3)
            printf "%-26s  %-22s  %10s  %8d  %12d  %10s  %12s\n", trim($1, 26), trim($2, 22), cost, $4, $5, $6, $7
          }
        '
    else
      jq -r "$rows_filter | [.project, .model, (.cost | tostring), (.messages | tostring), (.tokens | tostring)] | @tsv" <<<"$json" |
        awk -F '\t' -v show_header="$show_header" '
      function trim(s, n) {
        return length(s) > n ? substr(s, 1, n - 1) "..." : s
      }
      BEGIN {
        if (show_header == 1) {
          printf "%-32s  %-24s  %10s  %8s  %12s\n", "PROJECT", "MODEL", "COST", "MSGS", "TOKENS"
          printf "%-32s  %-24s  %10s  %8s  %12s\n", "-------", "-----", "----", "----", "------"
        }
      }
      {
        cost = sprintf("$%.2f", $3)
        printf "%-32s  %-24s  %10s  %8d  %12d\n", trim($1, 32), trim($2, 24), cost, $4, $5
      }
    '
    fi
  else
    if [[ "$include_usage" -eq 1 ]]; then
      jq -r --argjson usage "$usage_json" "$rows_filter$usage_join | [.model, (.cost | tostring), (.messages | tostring), (.tokens | tostring), .client, .provider, .fiveh, .weekly] | @tsv" <<<"$json" |
        awk -F '\t' -v show_header="$show_header" '
          function trim(s, n) {
            return length(s) > n ? substr(s, 1, n - 1) "..." : s
          }
          BEGIN {
            if (show_header == 1) {
              printf "%-24s  %10s  %8s  %12s  %-10s  %-10s  %10s  %12s\n", "MODEL", "COST", "MSGS", "TOKENS", "CLIENT", "PROVIDER", "5H USAGE", "WEEKLY USAGE"
              printf "%-24s  %10s  %8s  %12s  %-10s  %-10s  %10s  %12s\n", "-----", "----", "----", "------", "------", "--------", "--------", "------------"
            }
          }
          {
            cost = sprintf("$%.2f", $2)
            printf "%-24s  %10s  %8d  %12d  %-10s  %-10s  %10s  %12s\n", trim($1, 24), cost, $3, $4, trim($5, 10), trim($6, 10), $7, $8
          }
        '
    else
      jq -r "$rows_filter | [.model, (.cost | tostring), (.messages | tostring), (.tokens | tostring), .client, .provider] | @tsv" <<<"$json" |
        awk -F '\t' -v show_header="$show_header" '
      function trim(s, n) {
        return length(s) > n ? substr(s, 1, n - 1) "..." : s
      }
      BEGIN {
        if (show_header == 1) {
          printf "%-28s  %10s  %8s  %12s  %-12s  %-12s\n", "MODEL", "COST", "MSGS", "TOKENS", "CLIENT", "PROVIDER"
          printf "%-28s  %10s  %8s  %12s  %-12s  %-12s\n", "-----", "----", "----", "------", "------", "--------"
        }
      }
      {
        cost = sprintf("$%.2f", $2)
        printf "%-28s  %10s  %8d  %12d  %-12s  %-12s\n", trim($1, 28), cost, $3, $4, trim($5, 12), trim($6, 12)
      }
    '
    fi
  fi
}

if [[ "$continuous" -eq 1 ]]; then
  while true; do
    render_once
    sleep "$interval"
  done
fi

render_once
