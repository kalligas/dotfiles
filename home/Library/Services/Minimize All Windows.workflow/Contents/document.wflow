				<key>Category</key>
				<array>
					<string>AMCategoryUtilities</string>
				</array>
				<key>isViewVisible</key>
				<true/>
				<key>UUID</key>
				<string>0E9B57B0-C621-4C16-B977-A3E055BD6D98</string>
				<key>InputUUID</key>
				<string>5836FCDA-3421-4D72-98A2-B57D46C13DC9</string>
				<key>OutputUUID</key>
				<string>5FC1C722-7348-4F88-85CD-CE0E48090227</string>
			</dict>
			<key>isViewVisible</key>
			<true/>
		</dict>
	</array>
	<key>connectors</key>
	<dict/>
	<key>workflowMetaData</key>
	<dict>
		<key>applicationBundleIDsByPath</key>
		<dict/>
		<key>applicationPaths</key>
		<array/>
		<key>inputTypeIdentifier</key>
